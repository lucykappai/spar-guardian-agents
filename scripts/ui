#!/usr/bin/env bash
# Open the results browser.
#
#   scripts/ui              start the server if nothing listens on the port, then open the browser
#   scripts/ui --no-open    start it without opening the browser
#   scripts/ui stop         stop the server on the port: the pid it recorded, else whatever listens there
#   PORT=8766 scripts/ui    another port; each port has its own pid file and log, logs/ui-<port>.{pid,log}
#
# The server is python -m guardian.ui. Only a process whose command names guardian.ui is ever killed.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
PORT="${PORT:-8765}"
URL="http://127.0.0.1:$PORT/"
PY="$ROOT/.venv/bin/python"; [ -x "$PY" ] || PY="$(command -v python3)"
mkdir -p "$ROOT/logs"
PIDFILE="$ROOT/logs/ui-$PORT.pid"
LOG="$ROOT/logs/ui-$PORT.log"

listener_pid() { lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1; }
is_browser() { [ -n "${1:-}" ] && ps -p "$1" -o command= 2>/dev/null | grep -q "guardian.ui"; }

if [ "${1:-}" = "stop" ]; then
  pid=""
  [ -f "$PIDFILE" ] && pid="$(cat "$PIDFILE")"
  if ! is_browser "$pid"; then pid="$(listener_pid || true)"; fi
  if is_browser "$pid"; then
    kill "$pid" && echo "stopped results browser on port $PORT (pid $pid)"
  elif [ -n "$pid" ]; then
    echo "pid $pid listens on port $PORT but is not the results browser; not killed" >&2
    exit 1
  else
    echo "nothing listens on port $PORT"
  fi
  rm -f "$PIDFILE"
  exit 0
fi

if [ -z "$(listener_pid || true)" ]; then
  nohup "$PY" -m guardian.ui --port "$PORT" >> "$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  echo "started results browser on port $PORT (pid $!, log logs/ui-$PORT.log)"
  for _ in $(seq 1 100); do curl -fs "${URL}api/summary" >/dev/null 2>&1 && break; sleep 0.1; done
  curl -fs "${URL}api/summary" >/dev/null || { echo "server did not answer on $URL; see logs/ui-$PORT.log" >&2; exit 1; }
else
  echo "results browser already listening on $URL"
fi

echo "$URL"
if [ "${1:-}" != "--no-open" ]; then
  if command -v open >/dev/null; then open "$URL"; elif command -v xdg-open >/dev/null; then xdg-open "$URL"; fi
fi
